<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1E">

    <!-- SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="32dp"
            android:paddingBottom="80dp"> <!-- extra space for FAB -->

            <!-- TITLE -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My Tasks"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"/>

            <!-- DATE AND LIVE CLOCK -->
            <TextView
                android:id="@+id/tvDateTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monday · 07:30 AM"
                android:textColor="#8899BB"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="4dp"/>

            <!-- NOTIFICATION BUTTON -->
            <Button
                android:id="@+id/btnNotifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:text="🔔 Notifications"
                android:textColor="#8899BB"
                android:textSize="13sp"
                android:backgroundTint="#111827"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

            <!-- PROGRESS LABELS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvProgressLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 tasks completed"
                    android:textColor="#8899BB"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#8899BB"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- PROGRESS BAR -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="#1E2A45"
                android:layout_marginBottom="24dp">

                <View
                    android:id="@+id/progressBar"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:background="#22C55E"/>

            </FrameLayout>

            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✨ Add your tasks for the day!"
                android:textColor="#8899BB"
                android:textSize="15sp"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"/>
            <!--
                visibility=gone means hidden by default
                We show it only when there are no blocks
                Same as conditional rendering in React:
                {blocks.length === 0 && <EmptyState/>}
            -->

            <!-- TASK LIST -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FLOATING ADD BUTTON -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Add Task"
        android:src="@android:drawable/ic_input_add"
        android:tint="#FFFFFF"
        android:layout_gravity="bottom|end"
        app:backgroundTint="#3B82F6" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>