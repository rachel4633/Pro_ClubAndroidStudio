<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0A0F1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add New Block"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"/>

        <!-- TITLE INPUT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Title"
            android:textColor="#8899BB"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Deep coding session"
            android:textColorHint="#4B6A9B"
            android:textColor="#FFFFFF"
            android:inputType="text"
            android:background="@drawable/input_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginBottom="16dp"/>

        <!-- DESCRIPTION INPUT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textColor="#8899BB"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="What will you do during this block?"
            android:textColorHint="#4B6A9B"
            android:textColor="#FFFFFF"
            android:inputType="textMultiLine"
            android:lines="3"
            android:background="@drawable/input_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginBottom="16dp"/>

        <!-- SECTION DROPDOWN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Section"
            android:textColor="#8899BB"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>
        <EditText
            android:id="@+id/etTaskType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. coding, workout, teaching, chores..."
            android:textColorHint="#4B6A9B"
            android:textColor="#FFFFFF"
            android:inputType="text"
            android:background="@drawable/input_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginBottom="16dp"/>
        <!--
            Spinner is Android's dropdown selector
            Same as <select> in HTML
            We fill it with Morning, Classes, Afternoon, Evening in Kotlin
        -->

        <!-- TYPE DROPDOWN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Block Type"
            android:textColor="#8899BB"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <Spinner
            android:id="@+id/spinnerType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginBottom="16dp"/>

        <!-- START TIME -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Time"
            android:textColor="#8899BB"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:weightSum="2">

            <EditText
                android:id="@+id/etStartHour"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Hour (0-23)"
                android:textColorHint="#4B6A9B"
                android:textColor="#FFFFFF"
                android:inputType="number"
                android:background="@drawable/input_background"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/etStartMinute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Minute (0-59)"
                android:textColorHint="#4B6A9B"
                android:textColor="#FFFFFF"
                android:inputType="number"
                android:background="@drawable/input_background"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"/>

        </LinearLayout>

        <!-- END TIME -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="End Time"
            android:textColor="#8899BB"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:weightSum="2">

            <EditText
                android:id="@+id/etEndHour"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Hour (0-23)"
                android:textColorHint="#4B6A9B"
                android:textColor="#FFFFFF"
                android:inputType="number"
                android:background="@drawable/input_background"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/etEndMinute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Minute (0-59)"
                android:textColorHint="#4B6A9B"
                android:textColor="#FFFFFF"
                android:inputType="number"
                android:background="@drawable/input_background"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"/>

        </LinearLayout>

        <!-- MOTIVATION INPUT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Motivation Quote"
            android:textColor="#8899BB"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etMotivation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Lock in and build something great!"
            android:textColorHint="#4B6A9B"
            android:textColor="#FFFFFF"
            android:inputType="text"
            android:background="@drawable/input_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginBottom="24dp"/>

        <!-- ERROR MESSAGE -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FF4444"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"/>

        <!-- LOADING -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"/>

        <!-- ADD BUTTON -->
        <Button
            android:id="@+id/btnAddBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Block"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:layout_marginBottom="16dp"/>

        <!-- CANCEL BUTTON -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#8899BB"
            android:backgroundTint="#1E2A45"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

    </LinearLayout>
</ScrollView>