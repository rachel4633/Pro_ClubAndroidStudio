<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0F1E">

    <!--
        LinearLayout stacks children vertically (top → bottom)

        Structure:
        1. FrameLayout → main content area (fragments load here)
        2. BottomNavigationView → stays at bottom

        This is similar to a column layout in CSS
    -->

    <!-- MAIN CONTENT AREA -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!--
        FrameLayout acts like a container for fragments

        layout_height = 0dp + layout_weight = 1 means:
        → it takes ALL remaining space

        Equivalent to "flex: 1" in web development

        Every screen (Home, Profile, etc.) will be loaded here dynamically
    -->

    <!-- BOTTOM NAVIGATION BAR -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111827"

        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@drawable/nav_item_color"
        app:itemTextColor="@drawable/nav_item_color" />

    <!--
        BottomNavigationView = navigation bar at the bottom
        android:background → dark navy background
        app:menu → links to menu XML (icons + labels)
        app:itemIconTint + itemTextColor →
        uses a color selector to handle:
            - selected (blue)
            - unselected (gray)

        app:itemActiveIndicatorColor →
        background highlight (pill) behind selected item

        NOTE:
        We use a ColorStateList (nav_item_color.xml)
        instead of invalid attributes like:
            ❌ selectedItemTextColor
            ❌ selectedItemIconTint
    -->

</LinearLayout>